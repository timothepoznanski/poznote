{
  "manifest_version": 3,
  "name": "Poznote URL Saver",
  "version": "2.0",
  "description": "Saves the current page URL or screenshot to Poznote, as a new note or at the end of an existing one.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/api/v1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
