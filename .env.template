# Poznote Configuration
# Copy this file to .env and customize the values.
# Lines starting with # are optional settings left at their default.
# Changes apply when the containers are recreated: docker compose up -d

# =============================================================================
# WEB SERVER
# =============================================================================

# Port on which Poznote is reachable from your browser.
HTTP_WEB_PORT=8040

# Port the web server listens on inside the container (default 80, 8080 for
# the rootless image). Only needed with network_mode: host, where there is no
# port mapping and HTTP_WEB_PORT is unused. Leave it unset otherwise.
#POZNOTE_LISTEN_PORT=8040

# =============================================================================
# SIGN-IN (OIDC / SSO)
# =============================================================================

# Most OIDC settings (enabled, issuer, scopes, access control...) are managed
# from Settings > Admin Tools > OIDC / SSO. Only the client credentials and the
# SSO-only switch stay here.

# Client ID and secret from your OIDC application registration.
# Keep the secret private.
POZNOTE_OIDC_CLIENT_ID=your_client_id
POZNOTE_OIDC_CLIENT_SECRET=your_client_secret

# SSO-only sign-in. false (default) keeps the username/password login.
# true removes the login form, rejects password submissions server-side and
# hides the "Change Password" setting.
#
# IMPORTANT: while this is true nobody can sign in with a password, admins
# included, so there is no way back in from the browser if your identity
# provider goes down. Recovery needs server access: set it back to false,
# recreate the container and sign in with a local password. Before turning it
# on, make sure at least one admin account has a password set
# (Settings > Admin Tools > Users). Profiles created through OIDC have no
# password until an administrator sets one.
POZNOTE_OIDC_DISABLE_NORMAL_LOGIN=false

# =============================================================================
# SETTINGS PAGE PROTECTION
# =============================================================================

# Optional password asked before opening the Settings page.
# Leave empty for unrestricted access (default).
POZNOTE_SETTINGS_PASSWORD=

# =============================================================================
# MCP SERVER (AI ASSISTANTS)
# =============================================================================
# Details: docs/MCP-SERVER.md

# Port of the MCP server, published on 127.0.0.1 only (default 8045).
#POZNOTE_MCP_PORT=8045

# --- How clients are identified ----------------------------------------------
# Pick ONE of the three ways below (docs/MCP-SERVER.md, "Which mode for which
# use"). POZNOTE_MCP_AUTH_PROVIDER takes a single value: leave it unset for
# the classic mode, or set it to poznote OR to userinfo / introspection.
#
#   classic   You alone, client on the same machine. The server acts as
#             POZNOTE_USER_ID, and any request can name another profile.
#   poznote   Several people, chat apps (ChatGPT, Claude, Gemini), VS Code or
#             Claude Code reaching a public server. Each person signs in and
#             reaches only their own account.
#   userinfo / introspection
#             Agents holding tokens from your identity provider.

# --- 1. Classic mode (default) -----------------------------------------------
# Profile the server acts as when a request names none (default 1, the first
# admin). Ignored by the two other modes, where each client acts as its own
# account.
#POZNOTE_USER_ID=1

# Bearer token every client must send (Authorization: Bearer <token>).
# Leave empty to keep the endpoint open, which is safe while the port stays on
# 127.0.0.1. Set it if you expose the port beyond localhost.
# Generate one with: openssl rand -hex 32
#POZNOTE_MCP_AUTH_TOKEN=

# --- 2. Sign-in from chat apps (poznote) -------------------------------------
# The person signs in to Poznote as usual (password, two-factor or SSO), picks
# the access level, and the app reaches that person's own account only.
# Poznote and the MCP server must both be public over HTTPS, the MCP server on
# its own (sub)domain behind a reverse proxy.
#POZNOTE_MCP_AUTH_PROVIDER=poznote

# Public URL of the MCP server, without /mcp. Apps are given <this>/mcp, an
# address every user finds in Settings > My Account > Connected apps.
#POZNOTE_MCP_PUBLIC_URL=https://mcp.example.com

# Public URL of Poznote, where people sign in. Optional: it is normally the
# Instance URL of Settings > Admin Tools > Admin Webhooks (also used by
# reminder emails and webhooks); this value is used while that setting is
# empty.
#POZNOTE_APP_URL=https://notes.example.com

# --- 3. Tokens from your identity provider (userinfo / introspection) --------
# Each client presents its own token, checked against your identity provider
# and mapped to that caller's Poznote profile. An explicit user_id argument
# must match the caller's own profile, and the tools that take no user_id
# (get_system_info, list_backups, create_backup, delete_backup) are limited to
# administrators.
#
#   userinfo       GET  <url> with Authorization: Bearer <token> (OpenID
#                  Connect UserInfo, works for opaque tokens as well as JWTs)
#   introspection  POST <url> with token=<token> (RFC 7662)
#POZNOTE_MCP_AUTH_PROVIDER=userinfo
#POZNOTE_MCP_AUTH_URL=https://idp.example.com/userinfo

# Claims that identify the caller, as <poznote-profile-field>:<claim>, tried
# left to right. The first one present that matches exactly one profile wins;
# an identity matching no profile is refused. The default matches the subject
# only. preferred_username or email are weaker matches, opt in deliberately.
#POZNOTE_MCP_IDENTITY_MATCH=oidc_subject:sub

# Expected token audience, comma separated. Refuses a token the same provider
# issued for another application.
#POZNOTE_MCP_AUTH_AUDIENCE=

# Header this server sends TO the provider (not the one clients use).
#POZNOTE_MCP_AUTH_HEADER=Authorization

# introspection only, sent as HTTP Basic.
#POZNOTE_MCP_AUTH_CLIENT_ID=
#POZNOTE_MCP_AUTH_CLIENT_SECRET=

# Provider request timeout (seconds).
#POZNOTE_MCP_AUTH_TIMEOUT=5

# How long a checked token is cached, in seconds (modes 2 and 3). A
# disconnected app or revoked token can keep working that long.
#POZNOTE_MCP_AUTH_CACHE_TTL=60

# --- Tool scope --------------------------------------------------------------
# Highest level of tools this server exposes (default admin):
#   read   tools that change nothing
#   write  read, plus changes that can be undone (notes, tasks, folders,
#          trash, restoring a revision)
#   admin  everything: emptying the trash, workspaces, backups, Git sync,
#          app settings, public sharing
# Tools above the level are not registered at all.
#POZNOTE_MCP_SCOPE=admin

# Mode 3 only: each caller's level can come from a claim of its token
# instead, as <claim value>=<level> pairs (in mode 2, each person picks the
# level on the consent page, still capped by POZNOTE_MCP_SCOPE). The caller gets the highest
# level its claim maps to, never above POZNOTE_MCP_SCOPE, and a caller whose
# claim maps to none is refused. The claim defaults to scope (space separated);
# a list claim such as groups or roles works too.
#POZNOTE_MCP_SCOPE_CLAIM=scope
#POZNOTE_MCP_SCOPE_MAP=poznote.read=read,poznote.write=write,poznote.admin=admin

# =============================================================================
# PERFORMANCE
# =============================================================================

# PHP requests handled at the same time (php-fpm pm.max_children, default 10).
# Short requests never fill it; long ones do (AI chat streaming, S3, git sync,
# large uploads). Raise it on a busy instance with several users; each busy
# worker costs about 25-30 MB.
#POZNOTE_PHP_FPM_MAX_CHILDREN=10

# PHP memory limit per request, in MB (default 512). A ceiling, not a
# reservation: backups, restores, exports and downloads are streamed, so only
# a single note of tens of MB can need more. Never set it above the host's
# memory, the kernel would kill the container instead of PHP reporting a clean
# error.
#POZNOTE_PHP_MEMORY_LIMIT=512

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Show PHP errors in the browser and enable verbose MCP server logs.
# Keep it off outside troubleshooting: error output can leak paths and
# configuration details.
#POZNOTE_DEBUG=false
