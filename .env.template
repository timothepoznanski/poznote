# Poznote Configuration
# Copy this file to .env and customize the values

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Web Server Configuration
# Port on which Poznote will be accessible
HTTP_WEB_PORT=8040

# Port the web server listens on inside the container (default 80, 8080 for
# the rootless image). Leave it unset with the default port mapping above.
# Set it when running with network_mode: host, where there is no mapping and
# the container binds the host's ports directly (HTTP_WEB_PORT is then
# unused). Applied when the container starts.
#POZNOTE_LISTEN_PORT=8040

# Port for the MCP server (AI assistant integration), bound to localhost only.
# Leave commented to use the default.
#POZNOTE_MCP_PORT=8045

# Optional bearer token that MCP clients must send to the MCP server
# (Authorization: Bearer <token>). Leave empty to keep the endpoint open,
# which is safe as long as the port stays published on 127.0.0.1 (default).
# Set it if you expose the MCP port beyond localhost. Generate one with:
#   openssl rand -hex 32
#POZNOTE_MCP_AUTH_TOKEN=

# Optional per-caller authentication for the MCP server. Leave
# POZNOTE_MCP_AUTH_PROVIDER unset to keep the single shared token above (or the
# open endpoint). When it is set, every client must present ITS OWN token, which
# is resolved against your identity provider and mapped to that caller's Poznote
# profile - one MCP instance, many callers, each identified separately. It takes
# precedence over POZNOTE_MCP_AUTH_TOKEN, which is then ignored.
#
#   userinfo       GET  <url>   Authorization: Bearer <token>   (OpenID Connect
#                  UserInfo - works for opaque tokens as well as JWTs)
#   introspection POST <url>   token=<token>                    (RFC 7662)
#
#POZNOTE_MCP_AUTH_PROVIDER=userinfo
#POZNOTE_MCP_AUTH_URL=https://idp.example.com/userinfo
# Which claim identifies the caller, tried left to right as
# <poznote-profile-field>:<claim>. The first claim present that matches exactly
# one profile wins; an identity matching no profile is refused, never mapped to
# a default profile. The default matches the subject alone. Matching on
# preferred_username or email is weaker than Poznote's own sign-in, which
# matches an email only when verified, so opt into those deliberately.
#POZNOTE_MCP_IDENTITY_MATCH=oidc_subject:sub
#
# Optional. Expected audience, comma separated. Refuses a token the same
# provider issued for a different application.
#POZNOTE_MCP_AUTH_AUDIENCE=
# The header this server sends TO the provider, not the one callers use.
#POZNOTE_MCP_AUTH_HEADER=Authorization
# introspection only: sent as HTTP Basic. Ignored by userinfo.
#POZNOTE_MCP_AUTH_CLIENT_ID=
#POZNOTE_MCP_AUTH_CLIENT_SECRET=
# Seconds. Provider request timeout, and how long a resolved token is cached.
#POZNOTE_MCP_AUTH_TIMEOUT=5
#POZNOTE_MCP_AUTH_CACHE_TTL=60
#
# Two consequences of enabling this. An explicit user_id argument may only agree
# with the profile the token resolves to, and the tools that take no user_id
# (get_system_info, list_backups, create_backup, delete_backup) are limited to
# administrator callers, so the default profile has to be an administrator.

# Show PHP errors in the browser and enable verbose MCP server logging.
# Keep this off outside of troubleshooting: error output can leak paths and
# configuration details.
#POZNOTE_DEBUG=false

# Number of PHP requests the web server handles at the same time (php-fpm
# pm.max_children, default 10). Short requests never fill it; long ones do
# (AI chat streaming, S3, git sync, large uploads). Raise it on a busy
# instance with several users; each busy worker costs about 25-30 MB.
# Applied when the container starts.
#POZNOTE_PHP_FPM_MAX_CHILDREN=10

# PHP memory limit per request, in MB (default 512). A ceiling, not a
# reservation: backups, restores, exports and downloads stream whatever the
# size of the account, so only a single note of tens of MB can need more.
# Never set it above the memory of the host, the kernel would kill the
# container instead of PHP reporting a clean error. Applied when the
# container starts.
#POZNOTE_PHP_MEMORY_LIMIT=512

# =============================================================================
# AUTHENTICATION OIDC CONFIGURATION
# =============================================================================

# OIDC / SSO Authentication
# Most OIDC settings are now configured from the admin UI:
# Settings > Admin Tools > OIDC / SSO
#
# Client ID, Client Secret, and the SSO-only login toggle remain in .env.
# All other settings (enabled, issuer, scopes, access control, etc.)
# are managed from the admin interface and stored in the database.

# Client ID from your OIDC application registration
POZNOTE_OIDC_CLIENT_ID=your_client_id

# Client secret from your OIDC application registration (keep this secure!)
POZNOTE_OIDC_CLIENT_SECRET=your_client_secret

# Disable username/password login (SSO only)
# Set to true to force SSO-only login via OIDC.
# Set to false (default) to allow normal username/password login.
#
# This is the only switch that blocks password authentication: it removes the
# login form, rejects password submissions server-side, and hides the "Change
# Password" setting.
#
# IMPORTANT: while this is true nobody can sign in with a password, admins
# included, so there is no in-browser way back in if your identity provider
# goes down. Recovery requires server access: set this to false, restart the
# container, and sign in with a local password. Before turning it on, make
# sure at least one admin account has an explicit password set
# (Settings > Admin Tools > Users). Profiles auto-created through OIDC have no
# password at all until an administrator sets one.
POZNOTE_OIDC_DISABLE_NORMAL_LOGIN=false

# =============================================================================
# SETTINGS PAGE PROTECTION
# =============================================================================

# Optional password to protect access to the Settings page.
# When set, users must enter this password before accessing settings.
# Leave empty to allow unrestricted access (default).
POZNOTE_SETTINGS_PASSWORD=

