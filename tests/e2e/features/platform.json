{
  "title": "Accounts, administration, API, AI and MCP",
  "features": [
    {
      "id": "plat.api.notes-crud",
      "title": "REST: create, read and update a note, with the version check",
      "src": [
        "route:POST /notes",
        "route:GET /notes/{id}",
        "route:PATCH /notes/{id}"
      ]
    },
    {
      "id": "plat.api.notes-list",
      "title": "REST: list notes with filters, search, search ids, resolve a reference",
      "src": [
        "route:GET /notes",
        "route:GET /notes/search",
        "route:GET /notes/search/ids",
        "route:GET /notes/resolve"
      ]
    },
    {
      "id": "plat.api.notes-order",
      "title": "REST: reorder notes, favorites and clearing them, last opened note",
      "src": [
        "route:POST /notes/reorder",
        "route:POST /notes/{id}/favorite",
        "route:POST /notes/favorites/clear",
        "route:POST /notes/{id}/opened"
      ]
    },
    {
      "id": "plat.api.notes-attributes",
      "title": "REST: note tags, icon, colour, width, title style, pin, offline, Kanban state",
      "src": [
        "route:PUT /notes/{id}/tags",
        "route:PUT /notes/{id}/icon",
        "route:PUT /notes/{id}/color",
        "route:PUT /notes/{id}/pinned",
        "route:PUT /notes/{id}/content-width",
        "route:PUT /notes/{id}/title-style",
        "route:PUT /notes/{id}/offline",
        "route:POST /notes/{id}/kanban-completed"
      ]
    },
    {
      "id": "plat.api.notes-beacon",
      "title": "REST: emergency save of a note by sendBeacon",
      "src": [
        "route:POST /notes/{id}/beacon"
      ]
    },
    {
      "id": "plat.api.notes-lock",
      "title": "REST: note edit lock taken, read, kept alive, released",
      "src": [
        "route:POST /notes/{id}/lock",
        "route:GET /notes/{id}/lock",
        "route:POST /notes/{id}/lock/heartbeat",
        "route:POST /notes/{id}/lock/release"
      ]
    },
    {
      "id": "plat.api.notes-convert",
      "title": "REST: duplicate a note, convert it both ways, the HTML and Markdown converters",
      "src": [
        "route:POST /notes/{id}/duplicate",
        "route:POST /notes/{id}/convert",
        "route:POST /convert-html",
        "route:POST /convert-markdown"
      ]
    },
    {
      "id": "plat.api.trash",
      "title": "REST: trash a note, restore it, delete it for good, empty the trash",
      "src": [
        "route:DELETE /notes/{id}",
        "route:POST /notes/{id}/restore",
        "route:GET /trash",
        "route:DELETE /trash/{id}",
        "route:DELETE /trash"
      ]
    },
    {
      "id": "plat.api.graph",
      "title": "REST: backlinks, note graph, change probe",
      "src": [
        "route:GET /notes/{id}/backlinks",
        "route:GET /graph",
        "route:GET /changes"
      ]
    },
    {
      "id": "plat.api.notes-templates",
      "title": "REST: list templates and notes with attachments",
      "src": [
        "route:GET /notes/templates",
        "route:GET /notes/with-attachments"
      ]
    },
    {
      "id": "plat.api.offline",
      "title": "REST: offline manifest, list and note contents",
      "src": [
        "route:GET /offline/manifest",
        "route:GET /offline/list",
        "route:GET /offline/notes"
      ]
    },
    {
      "id": "plat.api.snapshots",
      "title": "REST: note snapshots created, listed, read, restored, deleted",
      "src": [
        "route:POST /notes/{id}/snapshot",
        "route:GET /notes/{id}/snapshots",
        "route:GET /notes/{id}/snapshot",
        "route:POST /notes/{id}/snapshot/restore",
        "route:DELETE /notes/{id}/snapshot"
      ]
    },
    {
