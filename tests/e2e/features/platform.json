        "route:PATCH /notes/{id}/tasks/{taskId}/subtasks/{subtaskId}",
        "route:DELETE /notes/{id}/tasks/{taskId}/subtasks/{subtaskId}",
        "route:GET /tasks"
      ]
    },
    {
